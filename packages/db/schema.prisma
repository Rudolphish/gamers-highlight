generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // アプリの実行時はSupavisorプーラー（6543番）。サーバーレスで接続数を食い潰さないため。
  url      = env("DATABASE_URL")
  // マイグレーション（db push / migrate）はプーラー経由だとアドバイザリロックが
  // 成立せず、エラーも出さずにハングする。Prismaにここを直接接続へ振り分けさせる。
  // これが無いと、スキーマを変えるたびに .env の DATABASE_URL を手で直接接続へ
  // 書き換えて実行し、プーラーへ戻す、という手順が必要になる（戻し忘れの事故が起きる）。
  directUrl = env("DATABASE_DIRECT_CONNECT")
}

enum AlbumRole {
  OWNER
  EDITOR
  VIEWER
}

enum GroupRole {
  OWNER
  EDITOR
  VIEWER
}

enum PhotoSource {
  MANUAL
  DISCORD
}

enum GroupGameStatus {
  WISHLIST
  PLAYING
  BACKLOG
  COMPLETED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ProposalReactionType {
  LIKE
  MAYBE
  PASS
}

enum MediaType {
  IMAGE
  VIDEO
}

// 招待制のアクセス制御。ここに登録されているDiscordアカウント/メールアドレスの人だけ
// ログインできる（友人グループなどクローズドな運用を想定）。
// 運用開始時はPrisma Studio等で手動登録する想定（管理UIは将来の拡張）。
model AllowlistEntry {
  id            String   @id @default(cuid())
  discordUserId String?  @unique
  email         String?  @unique
  note          String? // 「たける」等、誰を許可したかわかるメモ
  createdAt     DateTime @default(now())

  @@map("allowlist_entries")
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  avatarUrl     String?
  provider      String?
  discordUserId String?  @unique
  createdAt     DateTime @default(now())

  ownedAlbums      Album[]                @relation("AlbumOwner")
  uploadedPhotos   Photo[]                @relation("PhotoUploader")
  albumMemberships AlbumMember[]
  channelMappings  DiscordChannelMapping[]
  gameTags         DiscordGameTag[]
  ownedGroups      Group[]                @relation("GroupOwner")
  groupMemberships GroupMember[]
  addedGroupGames  GroupGame[]            @relation("GroupGameAddedBy")
  proposedGames    GroupGameProposal[]    @relation("ProposalProposedBy")
  proposalReactions GroupGameProposalReaction[]
  gameInterests    GroupGameInterest[]

  @@map("users")
}

// 複数アルバムを束ねる上位単位。基本的に1グループ=1Discordサーバーを想定し、
// Botの自動取り込み時にguildIdからどのグループにアルバムを自動作成するか判定する。
model Group {
  id                    String   @id @default(cuid())
  name                  String
  guildId               String?  @unique
  notificationChannelId String? // ウィッシュリストの最安値更新通知の投稿先チャンネル（未設定なら通知しない）
  ownerId               String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  owner     User                @relation("GroupOwner", fields: [ownerId], references: [id])
  albums    Album[]
  members   GroupMember[]
  games     GroupGame[]
  proposals GroupGameProposal[]

  @@map("groups")
}

// Steam/YouTube/HowLongToBeatへの外部問い合わせ結果をsteamAppId単位でキャッシュする。
// GroupGameは元々グループ単位のレコードのため、複数グループが同じゲームを追加すると
// これらの外部APIに毎回問い合わせが発生していた（特にYouTube search.listはクォータが厳しい）。
// GroupGame作成時にまずここを見て、あれば再利用する（無ければ取得してここにも保存する）。
model ExternalGameCache {
  steamAppId             Int      @id
  genres                 String[] @default([])
  headerImage            String? // appdetailsが返すヘッダー画像URL。固定パスの組み立てでは新しいタイトルが404になるため必ずAPI値を使う
  youtubeVideoId         String?
  hltbGameId             Int?
  hltbMainHours          Float?
  hltbMainExtraHours     Float?
  hltbCompletionistHours Float?
  hltbAllStylesHours     Float?
  updatedAt              DateTime @updatedAt

  @@map("external_game_caches")
}

// グループ単位で共有される「気になっている/遊んでいるゲーム」リスト（柱2）。
// 個人のウィッシュリスト/ライブラリはSteam自体で完結するため作らず、
// あくまで「このグループとして」のステータスのみを管理する。
model GroupGame {
  id             String          @id @default(cuid())
  groupId        String
  steamAppId     Int
  title          String
  coverUrl       String?
  status         GroupGameStatus @default(WISHLIST)
  genres         String[]        @default([]) // Steam appdetailsの英語ジャンル名（例: "Action", "RPG"）
  youtubeVideoId String? // 追加時に1回だけ検索して保存（YouTube APIの検索クォータ節約のため）
  hltbGameId             Int? // HowLongToBeatの数値ゲームID。ゲームページへの正確なリンクに使う
  hltbMainHours          Float? // HowLongToBeat: クリアのみ（時間）。追加時に1回だけ取得
  hltbMainExtraHours     Float? // やり込み要素込み
  hltbCompletionistHours Float? // 完全収集
  hltbAllStylesHours     Float? // 全プレイスタイル平均
  albumId        String?         @unique // 紐付け元のアルバム（あれば）。1アルバム=最大1ゲームを想定
  addedById      String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // 最安値更新通知（Discord）用。日次cronが前回記録との比較に使う。WISHLISTのみ対象。
  lastKnownLowPrice   Float?
  lastKnownLowShop    String?
  lastPriceCheckedAt  DateTime?

  group     Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  album     Album?              @relation(fields: [albumId], references: [id], onDelete: SetNull)
  addedBy   User                @relation("GroupGameAddedBy", fields: [addedById], references: [id])
  interests GroupGameInterest[]

  @@unique([groupId, steamAppId])
  @@index([groupId])
  @@map("group_games")
}

// グループ共有ウォッチリストの「気になってる」マーク（柱3）。
// GroupGame.statusが「グループとして」の状態を表すのに対し、こちらはメンバー個人が
// 軽く興味を表明するためのもの（ステータスは変えない）。誰が狙っているかが分かるほか、
// 最安値更新のDiscord通知に「気になっているメンバー」を添えるのにも使う。
model GroupGameInterest {
  id          String   @id @default(cuid())
  groupGameId String
  userId      String
  createdAt   DateTime @default(now())

  groupGame GroupGame @relation(fields: [groupGameId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupGameId, userId])
  @@index([groupGameId])
  @@map("group_game_interests")
}

// メンバーが「このゲームどう？」と提案し、他メンバーがリアクションできる仕組み。
// LIKEが過半数（floor(メンバー数/2)+1）に達すると自動でGroupGame（WISHLIST）に昇格する。
// steamAppIdの重複はAPI側でチェックする（却下後の再提案を許すため、DB制約では縛らない）。
model GroupGameProposal {
  id           String         @id @default(cuid())
  groupId      String
  steamAppId   Int
  title        String
  coverUrl     String?
  proposedById String
  status       ProposalStatus @default(PENDING)
  createdAt    DateTime       @default(now())

  group      Group                       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  proposedBy User                        @relation("ProposalProposedBy", fields: [proposedById], references: [id])
  reactions  GroupGameProposalReaction[]

  @@index([groupId])
  @@map("group_game_proposals")
}

model GroupGameProposalReaction {
  id         String               @id @default(cuid())
  proposalId String
  userId     String
  type       ProposalReactionType
  createdAt  DateTime             @default(now())

  proposal GroupGameProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([proposalId, userId])
  @@map("group_game_proposal_reactions")
}

model GroupMember {
  id         String    @id @default(cuid())
  groupId    String
  userId     String
  role       GroupRole @default(VIEWER)
  invitedAt  DateTime  @default(now())
  acceptedAt DateTime?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_members")
}

model Album {
  id              String   @id @default(cuid())
  title           String
  description     String?
  coverImageId    String?
  gameTitle       String?
  steamAppId      Int? // Steamストアのapp ID。設定時はアルバムのサムネイルにSteamのヘッダー画像を使う
  isAutoGenerated Boolean  @default(false)
  ownerId         String
  groupId         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner              User                    @relation("AlbumOwner", fields: [ownerId], references: [id])
  group               Group                   @relation(fields: [groupId], references: [id])
  photos              Photo[]
  members             AlbumMember[]
  discordAutoMappings DiscordChannelMapping[]
  discordGameTags     DiscordGameTag[]
  groupGame           GroupGame?

  @@index([ownerId])
  @@index([groupId])
  @@map("albums")
}

// 画像・動画どちらも1レコードで表現する（テーブル名は歴史的経緯で photos のまま）
model Photo {
  id               String      @id @default(cuid())
  mediaType        MediaType   @default(IMAGE)
  mediaUrl         String
  thumbnailUrl     String?
  durationSeconds  Int?        // 動画のみ。IMAGE の場合は null
  sizeBytes        Int?
  uploaderId       String
  albumId          String?
  gameTitle        String?
  capturedAt       DateTime?
  source           PhotoSource @default(MANUAL)
  discordMessageId String?     @unique
  createdAt        DateTime    @default(now())

  uploader User   @relation("PhotoUploader", fields: [uploaderId], references: [id])
  album    Album? @relation(fields: [albumId], references: [id])

  @@index([albumId])
  @@index([gameTitle])
  @@index([mediaType])
  @@map("photos")
}

model AlbumMember {
  id         String    @id @default(cuid())
  albumId    String
  userId     String
  role       AlbumRole @default(VIEWER)
  invitedAt  DateTime  @default(now())
  acceptedAt DateTime?

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([albumId, userId])
  @@map("album_members")
}

// ハッシュタグ⇄ゲームの対応表。1チャンネル運用（複数ゲームが1つのチャンネルに
// 混在する）向けの主軸となる仕組み。投稿本文の「#eldenring」等を拾って解決する。
// 初出のタグは自動でここに登録され、対応するAlbumも自動作成される。
model DiscordGameTag {
  id           String   @id @default(cuid())
  guildId      String
  tag          String   // 正規化済み（小文字・記号除去）のタグ文字列
  gameTitle    String   // 表示用のゲーム名（初回投稿時のタグから生成、後でUIから改名可能）
  autoAlbumId  String
  registeredBy String
  createdAt    DateTime @default(now())

  autoAlbum Album @relation(fields: [autoAlbumId], references: [id])
  user      User  @relation(fields: [registeredBy], references: [id])

  @@unique([guildId, tag])
  @@map("discord_game_tags")
}

// チャンネル⇄ゲームの対応表。ゲームごとにチャンネルが分かれているサーバー向け。
// DiscordGameTag（ハッシュタグ方式）と併用可能：
// ingest時はまずハッシュタグを優先し、無ければこちらにフォールバックする。
model DiscordChannelMapping {
  id           String   @id @default(cuid())
  guildId      String
  channelId    String   @unique
  gameTitle    String
  autoAlbumId  String
  registeredBy String
  createdAt    DateTime @default(now())

  autoAlbum Album @relation(fields: [autoAlbumId], references: [id])
  user      User  @relation(fields: [registeredBy], references: [id])

  @@index([guildId])
  @@map("discord_channel_mappings")
}

// Discord Bot（apps/bot、PM2常駐プロセス）の死活監視用ハートビート。
// Bot側が起動時＋定期的にlastSeenAtを更新し、Vercel Cron（check-bot-health）が
// 日次でこれが古すぎないかチェックしてDiscordに通知する。常に単一行（id: "bot"）のみ。
model BotHeartbeat {
  id         String   @id
  lastSeenAt DateTime @default(now())

  @@map("bot_heartbeats")
}

// 外部APIの呼び出し回数を日別に記録する（管理者ページの使用量表示用）。
//
// 対象はYouTube Data APIのみ。search.listは1回100ユニット・無料枠が1日10,000で
// 実質100回/日しかなく、超えるとその日は関連動画が取れなくなるため、
// 残りが見えないと運用できない。
//
// ITAD/Steamを対象にしていないのは、Next.jsのデータキャッシュ越しに呼んでいて
// 「実際に外部へ出たか」がコード側から判別できず、呼び出し地点で数えると
// 過大計上になるため（キャッシュヒットも1回と数えてしまう）。
model ApiUsage {
  id      String   @id @default(cuid())
  service String // "youtube" など
  date    DateTime @db.Date // 日別集計。クォータのリセットに合わせUTC基準
  calls   Int      @default(0)
  units   Int      @default(0) // クォータ単位（YouTubeのsearch.listは1回100）

  @@unique([service, date])
  @@map("api_usages")
}
