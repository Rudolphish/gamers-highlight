{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm --filter web exec tsc --noEmit *)",
      "Bash(git add *)",
      "Read(//c/Users/rudir/.claude/projects/c--Study-gamers-highlight/**)",
      "Bash(pnpm pm2:restart)",
      "Bash(pm2 restart *)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" https://sharestaq.vercel.app/login)",
      "Bash(git -C \"c:/Study/gamers-highlight\" check-ignore -v .claude/settings.local.json)",
      "WebFetch(domain:howlongtobeat.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:github.com)",
      "Bash(node scratch-hltb-debug.mjs)",
      "Bash(node -e ' *)",
      "WebFetch(domain:docs.isthereanydeal.com)",
      "PowerShell(git push origin master)",
      "PowerShell(git -c http.sslBackend=schannel push origin master)",
      "PowerShell(pnpm --filter @gamers-highlight/db exec prisma generate)",
      "PowerShell(pnpm --filter web exec tsc --noEmit)",
      "PowerShell(pnpm --filter web build 2>&1)",
      "PowerShell(git add -A)",
      "PowerShell(pnpm --filter web dev)",
      "Bash(git -c http.sslBackend=schannel push origin master)",
      "Bash(node -e \"JSON.parse\\(require\\('fs'\\).readFileSync\\('.claude/settings.json','utf8'\\)\\);console.log\\('valid JSON'\\)\")"
    ],
    "deny": [
      "Edit(.npmrc)",
      "Edit(**/.npmrc)",
      "PowerShell(*.npmrc*)",
      "Bash(*prisma migrate deploy*)",
      "Bash(*prisma migrate reset*)",
      "Bash(*prisma db push*)",
      "Bash(*DATABASE_URL*supabase.co*)",
      "Bash(*vercel --prod*)",
      "Bash(*vercel deploy --prod*)",
      "Bash(*vercel env rm*)",
      "Bash(*vercel remove*)",
      "Bash(*git push --force*)",
      "Bash(*git push*--force*)",
      "Bash(*git push -f*)",
      "Bash(*rm -rf*)",
      "Bash(*rm -fr*)",
      "Bash(*rm -r *)",
      "Bash(*r2 rm*)",
      "Bash(*r2 delete*)",
      "Bash(*bucket delete*)",
      "PowerShell(*prisma migrate deploy*)",
      "PowerShell(*prisma migrate reset*)",
      "PowerShell(*prisma db push*)",
      "PowerShell(*DATABASE_URL*supabase.co*)",
      "PowerShell(*vercel --prod*)",
      "PowerShell(*vercel deploy --prod*)",
      "PowerShell(*vercel env rm*)",
      "PowerShell(*vercel remove*)",
      "PowerShell(*git push --force*)",
      "PowerShell(*git push*--force*)",
      "PowerShell(*git push -f*)",
      "PowerShell(*Remove-Item*-R*)",
      "PowerShell(*rm *-R*)",
      "PowerShell(*ri *-R*)",
      "PowerShell(*rd *-R*)",
      "PowerShell(*rmdir *-R*)",
      "PowerShell(*del *-R*)",
      "PowerShell(*erase *-R*)",
      "PowerShell(*r2 rm*)",
      "PowerShell(*r2 delete*)",
      "PowerShell(*bucket delete*)"
    ],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "\\tmp"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-review.mjs\" --record-session-base",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-review.mjs\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
