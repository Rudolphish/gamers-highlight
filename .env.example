# apps/web/.env.local にコピーして値を入れる（ルートの .env ではない）。
# Vercel に入れるものと同じ一覧は docs/VERCEL_ENVIRONMENT_VARIABLES.md にある。
# 値の意味と落とし穴（プーラーと直接接続を混ぜない等）は CLAUDE.md を読むこと。

# ── DB（接続先が2つある。混同するとマイグレーションが無言で固まる）──
# アプリの実行時。Supavisor プーラー（6543番、pgbouncer=true）を指すこと
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# マイグレーション用の直接接続（5432番）。schema.prisma の directUrl が参照する
DATABASE_DIRECT_CONNECT="postgresql://USER:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# ── 認証 ──
NEXTAUTH_SECRET="openssl rand -base64 32 で作る"
NEXTAUTH_URL="http://localhost:3000"
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# 管理者（カンマ区切り）。許可リストの編集と /admin を使える人。
# **未設定なら誰も使えない**（フェイルクローズ）
ADMIN_EMAILS="you@example.com"

# ── ストレージ（Cloudflare R2 / S3互換）──
STORAGE_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# 公開URLの先頭。ここから始まらないURLは /api/photos が受け付けない
STORAGE_PUBLIC_URL="https://pub-XXXX.r2.dev"

# ── Bot ⇄ Web の内部API ──
INTERNAL_API_BASE_URL="http://localhost:3000"
INTERNAL_API_SECRET="任意の長い文字列。Bot側と揃える"
# Bot本体だけでなく Web からも使う（Discord REST APIへの直接投稿）
DISCORD_BOT_TOKEN=""
# Bot のスラッシュコマンドを登録するサーバー（apps/bot）
DISCORD_GUILD_ID=""

# ── 外部API ──
ITAD_API_KEY=""
YOUTUBE_API_KEY=""

# ── Vercel Cron ──
# /api/cron/* を認証する。cron は check-wishlist-prices と check-bot-health の2本
CRON_SECRET=""

# ── 任意 ──
# /admin の使用率の分母。未設定なら無料枠の目安（R2 10GB / DB 0.5GB）
# STORAGE_LIMIT_BYTES=""
# DATABASE_LIMIT_BYTES=""
# 開発用ログイン。NODE_ENV!=production と両方揃ったときだけ有効になる
# ENABLE_DEV_LOGIN="true"
