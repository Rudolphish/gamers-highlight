{
  "name": "bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "pm2:start": "pnpm build && pm2 start ecosystem.config.cjs",
    "pm2:restart": "pnpm build && pm2 restart gamers-highlight-bot",
    "pm2:stop": "pm2 stop gamers-highlight-bot",
    "pm2:logs": "pm2 logs gamers-highlight-bot"
  },
  "dependencies": {
    "discord.js": "^14.15.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.16.0",
    "@types/node": "^20.14.0"
  }
}
